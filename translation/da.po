msgctxt "Rails,Rails_Item_DepotItem_A2_Description"
msgid ""
msgstr "\"Denne is er sær. Jeg har aldrig set argon opføre sig på denne måde før--vi må tjekke om der er elektriske forstyrrelser i undergrunden.\"-Bell "

