msgid ""
msgstr "Fund"

msgctxt "Rails,Rails_Item_DepotItem_B1_Name_AllCaps"
msgid ""
msgstr "FUND"

msgctxt "Rails,Rails_Item_DepotItem_B2_Description"
msgid ""
msgstr "\"Mysteriet fortsætter! Jeg har opdaget at disse obelisker afgiver en sært signal, som om de prøver at sende en besked. Det er ikke digitalt og derfor ikke til et decifrere lige nu og her, men jeg tror på at det kan lade sig gøre over tid.\"-Doktor Stone"

