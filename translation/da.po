msgctxt "Chronos,Chronos_MissionData_Chronos009b_Description"
msgid ""
msgstr ""

msgctxt "Chronos,Chronos_MissionData_Chronos009b_Objective1"
msgid ""
msgstr "Brug Fejlfinder til at finde mindefragmenter i kode på Calidor"

msgctxt "Chronos,Chronos_MissionData_Chronos009b_Objective2"
msgid ""
msgstr "Hent Minde om Håb"

msgctxt "Chronos,Chronos_MissionData_Chronos009b_Title"
msgid ""
msgstr "Mindefragment: Håb"

msgctxt "Chronos,Chronos_MissionData_Chronos009c_Description"
msgid ""
msgstr "Tag venligst tilbage til Solrummet og placér mindet på Mindespolen for mig, som du tidligere har gjort."

msgctxt "Chronos,Chronos_MissionData_Chronos009c_Objective1"
msgid ""
msgstr "Placér Minde om Håb på Solrummets Mindespole"

msgctxt "Chronos,Chronos_MissionData_Chronos009c_Title"
msgid ""
msgstr "Mindeintegration: Håb"

msgctxt "Chronos,Chronos_MissionData_Chronos009d_Description"
msgid ""
msgstr "Åh nej. Dette var ikke den information jeg havde regnet med. Tjek venligst Solrumsloggen for nye poster, og så lad os diskutere vores næste skridt."

msgctxt "Chronos,Chronos_MissionData_Chronos009d_Objective1"
msgid ""
msgstr "Tilgå Solrumslog"

msgctxt "Chronos,Chronos_MissionData_Chronos009d_Title"
msgid ""
msgstr "Det Efterladte"

msgctxt "Chronos,Chronos_MissionData_Chronos009e_Description"
msgid ""
msgstr "Jeg ved det lyder dystert. Vær ikke bekymret. Når min mission er fuldendt, skal alt nok blive godt. Måske kan vi endda se nye planeter som prinsen i Chronos' yndlingsbog. Har du tænkt over hvorfor han ser ud som han gør? Hans dragt ser meget finere ud end din. "

msgctxt "Chronos,Chronos_MissionData_Chronos009e_Objective1"
msgid ""
msgstr "Tryk på knappen for at anerkende Chronos' fornemme beklædning"

msgctxt "Chronos,Chronos_MissionData_Chronos009e_Title"
msgid ""
msgstr "Chronos Elsker Læsning "

msgctxt "Chronos,Chronos_MissionData_Chronos009f_Description"
msgid ""
msgstr ""
"Undskyld. Jeg tror det var uhøfligt? Din dragt er meget praktisk. Den passer godt til dig. \n"
"\n"
"Har du set at jeg er en ræv? Det var også en del af historien. Jeg elskede at høre Chronos forælle den mens han skabte mig. "

msgctxt "Chronos,Chronos_MissionData_Chronos009f_Objective1"
msgid ""
msgstr ""

msgctxt "Chronos,Chronos_MissionData_Chronos009f_Title"
msgid ""
msgstr "Jeg er en Ræv "

msgctxt "Chronos,Chronos_MissionData_Chronos009g_Description"
msgid ""
msgstr ""

msgctxt "Chronos,Chronos_MissionData_Chronos009g_Objective1"
msgid ""
msgstr ""

msgctxt "Chronos,Chronos_MissionData_Chronos009g_Title"
msgid ""
msgstr "Vi Er Der Næsten"

msgctxt "Chronos,Chronos_MissionData_Chronos010_Description"
msgid ""
msgstr "Jeg vil gerne beklage. Jeg tog fejl. Dette var ikke de forkerte minder...Jeg tror at Chronos efterlod dem til mig, så jeg bedre kunne forstå min mission. Jeg har opdaget endnu et minde nu. Det er her...i Solrummet."

msgctxt "Chronos,Chronos_MissionData_Chronos010_Objective1"
msgid ""
msgstr "Fraktalrose sået i Solrum"

msgctxt "Chronos,Chronos_MissionData_Chronos010_Title"
msgid ""
msgstr "Sidste Godkendelse"

msgctxt "Chronos,Chronos_MissionData_Chronos011_Description"
msgid ""
msgstr "Ah. Nu forstår jeg hvad vi skal gøre. Tjek Solrumsloggen for nye poster, så kan vi måske færdiggøre vores fælles mission."

msgctxt "Chronos,Chronos_MissionData_Chronos011_Objective1"
msgid ""
msgstr "Tilgå Solrumslog"

msgctxt "Chronos,Chronos_MissionData_Chronos011_Title"
msgid ""
msgstr "[FEJL]"

msgctxt "Chronos,Chronos_MissionData_Chronos012_Description"
msgid ""
msgstr "Chronos ønskede dette. Det er derfor jeg blev skabt. Jeg er yderst taknemmelig for at vi kunne mødes. Nu mangler vi bare at sende signalet."

msgctxt "Chronos,Chronos_MissionData_Chronos012_Objective1"
msgid ""
msgstr "Autorisér EVA til at sende SOS-signalet"

msgctxt "Chronos,Chronos_MissionData_Chronos012_Title"
msgid ""
msgstr "S-O-S"

msgctxt "Chronos,Chronos_MissionData_Chronos013_Description"
msgid ""
msgstr "Jeg har genskabt et sidste Chronos-minde til dig. Det er i Solrummets log. Tak for hjælpen med at færdiggøre min mission. Farvel. -EVA"

msgctxt "Chronos,Chronos_MissionData_Chronos013_Objective1"
msgid ""
msgstr "Indsaml Chonos'  Krone"

msgctxt "Chronos,Chronos_MissionData_Chronos013_Objective2"
msgid ""
msgstr "Tilgå Solrumslog"

msgctxt "Chronos,Chronos_MissionData_Chronos013_Title"
msgid ""
msgstr "Farvel Så Længe..."

msgctxt "Chronos,Chronos_MissionData_Chronos014_Description"
msgid ""
msgstr "Jeg har efterladt en sidste gave til dig, gemt i koden: En ekstra sikkerhedskopi jeg lavede. Tag dig godt af hende. -Chronos"

msgctxt "Chronos,Chronos_MissionData_Chronos014_Objective1"
msgid ""
msgstr "Fraktalrose sået på Sylva"

msgctxt "Chronos,Chronos_MissionData_Chronos014_Title"
msgid ""
msgstr "...For Nu"

